# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/herbalcommerce

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Redis (future)
REDIS_URL=redis://localhost:6379
DB_HOST=postgres DB_PORT=5432 DB_NAME=herbalcommerce DB_USER=postgres DB_PASS=postgres PORT=4000 JWT_SECRET=dev-secret JWT_EXPIRES=7d
